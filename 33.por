programa
{

    funcao inteiro somar(inteiro a, inteiro b)
    {
        retorne a + b
    }

    funcao inicio()
    {
        inteiro resultado

        resultado = somar(15, 7) 

        escreva("O resultado da soma é: ", resultado, "\n")
        
        escreva("O resultado de 10 + 5 é: ", somar(10, 5), "\n")
    }
}