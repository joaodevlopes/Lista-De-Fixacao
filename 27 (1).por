programa
{
   funcao mostrarLinha()
    {
        escreva("====================\n")
    }

    funcao inicio()
    {
        escreva("Início do Programa\n")
        
        mostrarLinha()
        
        escreva("Meio do Processamento\n")
        
        mostrarLinha()
        
        escreva("Finalizando Tarefas\n")
        
        mostrarLinha()
        
        escreva("Fim\n")
    }
}